WebServer server(80);


float temperature = 26.0;
float humidity = 60.0;

bool automaticMode = true;
bool playing = false;

int volumeLevel = 20;
int currentTrack = 3;

String mood = "calm";

unsigned long lastPrint = 0;
unsigned long lastMoodChange = 0;

const unsigned long MOOD_COOLDOWN = 15000;




int trackForMood(const String& value) {
  if (value == "rainy") return 1;
  if (value == "energetic") return 2;
  return 3;
}

String determineMood() {
  if (humidity >= 75.0) return "rainy";
  if (temperature >= 30.0) return "energetic";
  return "calm";
}

void playTrack(int track) {
  currentTrack = constrain(track, 1, 3);
  playing = true;

  Serial.println();
  Serial.println("===== DFPLAYER SIMULATION =====");
  Serial.print("Playing MP3 track: ");
  Serial.println(currentTrack);
  Serial.println("===============================");
}

void applyMood(bool force = false) {
  if (!automaticMode) return;

  String desired = determineMood();

  if (desired == mood) return;

  if (!force &&
      millis() - lastMoodChange < MOOD_COOLDOWN) {
    return;
  }

  mood = desired;
  lastMoodChange = millis();

  Serial.print("Weather mood changed to: ");
  Serial.println(mood);

  playTrack(trackForMood(mood));
}



String jsonState() {
  String json = "{";

  json += "\"temperature\":";
  json += String(temperature, 1);
  json += ",";

  json += "\"humidity\":";
  json += String(humidity, 1);
  json += ",";

  json += "\"mood\":\"" + mood + "\",";

  json += "\"automatic\":";
  json += automaticMode ? "true," : "false,";

  json += "\"playing\":";
  json += playing ? "true," : "false,";

  json += "\"track\":";
  json += String(currentTrack);
  json += ",";

  json += "\"volume\":";
  json += String(volumeLevel);
  json += ",";

  json += "\"simulation\":true";
  json += "}";

  return json;
}



