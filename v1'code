async function send(action, value) {
  try {
    let url = '/api/control?action=' +
              encodeURIComponent(action);

    if (value !== undefined) {
      url += '&value=' + encodeURIComponent(value);
    }

    const response = await fetch(url, {
      method: 'POST'
    });

