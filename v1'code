}




void handleSerial() {
  if (!Serial.available()) return;

  String command = Serial.readStringUntil('\n');
  command.trim();
  command.toLowerCase();

  if (command == "rain") {
    temperature = 24;
    humidity = 85;
    applyMood(true);
  }

  else if (command == "hot") {
    temperature = 35;
    humidity = 40;
    applyMood(true);
  }

  else if (command == "calm") {
    temperature = 22;
    humidity = 55;
    applyMood(true);
  }

  else if (command == "auto") {
    automaticMode = true;
    applyMood(true);
  }

  else if (command == "manual") {
    automaticMode = false;
  }

  else if (command == "play") {
    playing = true;
  }

  else if (command == "pause") {
    playing = false;
  }

  else if (command == "next") {
    automaticMode = false;
    playTrack(currentTrack % 3 + 1);
  }

  else if (command == "previous") {
    automaticMode = false;
    playTrack((currentTrack + 1) % 3 + 1);
  }

  else if (command != "status") {
    Serial.println("Unknown command");
  }

  printWeather();
}


void setup() {
  Serial.begin(115200);
  Serial.setTimeout(100);

  delay(500);

  Serial.println();
  Serial.println("tkgod11 Starting...");
  Serial.println("Wokwi Simulation Mode");

#if ENABLE_WIFI_AP

  WiFi.mode(WIFI_AP);

  if (WiFi.softAP(AP_SSID, AP_PASSWORD)) {
    Serial.print("Dashboard: http://");
    Serial.println(WiFi.softAPIP());
  } else {
    Serial.println("WiFi AP failed");
  }

  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", PAGE);
  });

  server.on("/api/state", HTTP_GET, []() {
    server.send(200, "application/json",
                jsonState());
  });

  server.on("/api/control", HTTP_POST,
            handleControl);

  server.begin();

#endif

  mood = determineMood();
  currentTrack = trackForMood(mood);

  Serial.println();
  Serial.println("Available commands:");
  Serial.println("rain, hot, calm");
  Serial.println("auto, manual");
  Serial.println("play, pause");
  Serial.println("next, previous, status");

  printWeather();
}




void loop() {
#if ENABLE_WIFI_AP
  server.handleClient();
#endif

  handleSerial();

  if (millis() - lastPrint >= 5000) {
    lastPrint = millis();
    printWeather();
  }

  delay(10);
}
